{
  "name": "paris-manif-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Paris Manif 3D — jeu web 3D stylisé, prototype (incrément 1)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node e2e/fumee.mjs && node e2e/partie.mjs",
    "equilibrage": "EQUILIBRAGE=1 vitest run tests/equilibrage.test.ts"
  },
  "dependencies": {
    "playcanvas": "2.23.3"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
