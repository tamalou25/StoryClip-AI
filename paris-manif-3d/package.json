{
  "name": "paris-manif-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Paris Manif 3D — jeu web 3D stylisé, prototype (incrément 1)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:e2e": "node e2e/fumee.mjs && node e2e/partie.mjs",
    "test:multi": "node e2e/multijoueur.mjs",
    "equilibrage": "EQUILIBRAGE=1 vitest run tests/equilibrage.test.ts",
    "serveur": "tsx server/index.ts",
    "serveur:dev": "tsx watch server/index.ts",
    "serveur:build": "vite build --ssr server/index.ts --outDir dist-serveur --emptyOutDir",
    "serveur:start": "node dist-serveur/index.js"
  },
  "dependencies": {
    "playcanvas": "2.23.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
